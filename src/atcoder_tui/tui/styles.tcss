/* lazygit 風: 左に積んだパネル + 右に大きな本文。フォーカス中のパネルを強調。 */

/* Textual's equivalent of a NONE background is transparent. */
App,
Screen,
Header,
DataTable {
	background: transparent;
}

#body {
	height: 1fr;
}

#left {
	width: 38%;
	min-width: 28;
	height: 1fr;
}

#problems-panel {
	height: 1fr;
	border: round $primary;
	border-title-align: left;
	padding: 0 1;
}

#results-panel {
	height: 40%;
	min-height: 8;
	border: round $primary;
	border-title-align: left;
}

#statement-panel {
	width: 1fr;
	height: 1fr;
	border: round $primary;
	border-title-align: left;
	padding: 0 1;
	scrollbar-background: transparent;
	scrollbar-background-hover: transparent;
	scrollbar-background-active: transparent;
}

/* フォーカス中のパネルをアクセントカラーで縁取る (lazygit のアクティブ枠)。 */
#problems-panel:focus-within,
#results-panel:focus-within,
#statement-panel:focus-within {
	border: round $accent;
}

#problem-list {
	height: 1fr;
	background: transparent;
}

#statement-md {
	height: auto;
}

/* Keep inline code readable without the default warning-colored background. */
#statement-md MarkdownBlock > .code_inline {
	background: transparent !important;
	color: $warning !important;
}

#status-bar {
	dock: bottom;
	width: 100%;
	height: 1;
	align-horizontal: right;
}

#language-status {
	width: auto;
	min-width: 24;
	height: 1;
	padding: 0 1;
	content-align: right middle;
}

/* モーダル共通 */
ModalScreen {
	align: center middle;
	background: transparent;
}

#login-dialog,
#confirm-dialog,
#language-dialog {
	width: 64;
	height: auto;
	max-height: 80%;
	padding: 1 2;
	border: thick $accent;
	background: transparent;
}

#contest-dialog {
	width: 90%;
	height: 80%;
	padding: 1 2;
	border: thick $accent;
	background: transparent;
}

#event-log-dialog {
	width: 90%;
	height: 80%;
	padding: 1 2;
	border: thick $accent;
	background: transparent;
}

#event-log-list {
	height: 1fr;
	border: round $primary-darken-2;
	padding: 0 1;
}

#contest-filter {
	margin-bottom: 1;
}

#contest-list {
	height: 1fr;
	border: round $primary-darken-2;
}

#contest-count {
	height: 1;
	color: $text-muted;
	margin-top: 1;
}

#contest-hint {
	height: 1;
	color: $text-muted;
	text-style: dim;
}

.dialog-title {
	text-style: bold;
	margin-bottom: 1;
	width: 1fr;
	content-align: left middle;
}

.dialog-buttons {
	height: auto;
	align-horizontal: right;
	margin-top: 1;
}

.dialog-buttons Button {
	margin-left: 2;
}

.dialog-field {
	margin-bottom: 1;
}
